#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# L4 写者仲裁 (R444)  —— docs/reports/endpoint-and-audit-contract.md L4 层
#
# 背景: R423/R431/R436/R440/R441/R442/R443 连续多轮发生**同 worktree 双写者**
#       (两个 hermes 进程同轮同目录), 症状是「轮号碰撞 + 对侧未跟踪文件混入」。
# 机制: 心跳文件 <git-dir>/ROUND_CLAIM 记录当前轮号的持有者 (round/pid/writer/ts)。
#       本钩子: 若心跳新鲜(pid 存活) 且 持有者 != $AGENTFRAMEWORK_WRITER ⇒ 拒绝提交。
#       陈旧心跳(pid 已死) 只告警并放行 (避免死锁)。
# 另加 L3 门禁: registry 机检违规 ⇒ 拒绝提交。
# 安装: bash tools/install_hooks.sh   (设置 core.hooksPath=tools/hooks)
# ---------------------------------------------------------------------------
set -u
GD="$(git rev-parse --git-dir 2>/dev/null || echo .git)"
# R444: 路径可覆盖 (AGENTFRAMEWORK_ROUND_CLAIM) —— 供 L2 负控在**不干扰真心跳**的前提下走同一代码路径。
CLAIM="${AGENTFRAMEWORK_ROUND_CLAIM:-$GD/ROUND_CLAIM}"
me="${AGENTFRAMEWORK_WRITER:-}"

if [ -f "$CLAIM" ]; then
  pid="$(sed -n 's/^pid=//p' "$CLAIM" | head -1)"
  ts="$(sed -n 's/^ts=//p' "$CLAIM" | head -1)"
  age="$(date -u +%s)"; age=$(( age - $(date -u -d "$ts" +%s 2>/dev/null || echo 0) ))
  [ "$age" -lt 5400 ] && [ "$age" -ge 0 ] && FRESH_AGE=1 || FRESH_AGE=0
  wr="$(sed -n 's/^writer=//p' "$CLAIM" | head -1)"
  rd="$(sed -n 's/^round=//p' "$CLAIM" | head -1)"
  if { [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; } || [ "$FRESH_AGE" = 1 ]; then
    if [ -n "$me" ] && [ "$wr" != "$me" ]; then
      echo "BLOCKED(L4 写者仲裁): 轮 $rd 正被另一写者持有 (pid=$pid writer=$wr)。" >&2
      echo "  本提交者 AGENTFRAMEWORK_WRITER=$me ⇒ 拒绝 (防撞号/防混入对侧文件)。" >&2
      echo "  若确认对侧已停: bash tools/round_claim.sh release" >&2
      exit 1
    fi
  else
    echo "WARN(L4): 心跳陈旧 (pid=$pid 不存活 且 age=${age}s ≥ TTL 5400s) ⇒ 放行; 清理: tools/round_claim.sh release --force" >&2
  fi
fi

if command -v python3 >/dev/null 2>&1 && [ -f eval/capability/status_gen.py ]; then
  if ! python3 eval/capability/status_gen.py --check >/tmp/status_gen_precommit.log 2>&1; then
    echo "BLOCKED(L3 审计面门禁): registry 机检违规。" >&2
    tail -10 /tmp/status_gen_precommit.log >&2
    exit 1
  fi
fi

# R539 ④: R1 生成物漂移闸 —— `tools/r1gen/gen_csharp.py --check` (生成器 ⇄ 生成物 同源闸) 挂到提交面。
#   动机: 手改生成物而没回写生成器 (实测 c7453d3 手改 StructuredPrompt.cs 未回写 ⇒ R1GEN_DRIFT=2)
#   会在下一轮以「前缀 pin 漂移 ⇒ rc=6」的面目出现, 定位成本高; 这里在提交时 fail-closed 拦下。
#   默认**开**; 越权关闸 (诊断/夹具): AGENTFRAMEWORK_R1GEN_CHECK=0。
#   代价实测 0.034s (零噪声: 干净态只打一行 GEN_PREFIX)。
if [ "${AGENTFRAMEWORK_R1GEN_CHECK:-1}" != "0" ] && [ -f tools/r1gen/gen_csharp.py ]; then
  if ! python3 tools/r1gen/gen_csharp.py --check >/tmp/r1gen_precommit.log 2>&1; then
    echo "BLOCKED(R539 生成物漂移闸): R1 生成物与生成器不同源 (手改生成物未回写?)。" >&2
    echo "  处置: python3 tools/r1gen/gen_csharp.py --write   # 由生成器回写生成物, 再重提交" >&2
    echo "  跳过本闸 (夹具/诊断): AGENTFRAMEWORK_R1GEN_CHECK=0" >&2
    grep -m 5 '^DRIFT' /tmp/r1gen_precommit.log >&2 || tail -5 /tmp/r1gen_precommit.log >&2
    exit 1
  fi
fi

# EXP1-Q31: 跨写者提交闸 —— staged 必须等于本轮声明清单 (默认关: 无 AGENTFRAMEWORK_STAGE_MANIFEST 则不生效)
if [ -n "${AGENTFRAMEWORK_STAGE_MANIFEST:-}" ]; then
  if [ ! -f "$AGENTFRAMEWORK_STAGE_MANIFEST" ]; then
    echo "BLOCKED(L4 跨写者提交闸): 声明清单不存在 $AGENTFRAMEWORK_STAGE_MANIFEST ⇒ 拒提交 (fail-closed)。" >&2
    exit 1
  fi
  if ! python3 eval/capability/exp1-q30/stage_guard_q30.py --list "$AGENTFRAMEWORK_STAGE_MANIFEST"; then
    echo "BLOCKED(L4 跨写者提交闸): staged != 本轮声明清单 ⇒ 拒提交 (防对侧在飞文件混入)。" >&2
    exit 1
  fi
fi
# EXP1-Q32: 器具/记录 pin 重审闸 —— 「器具改了而登记表未重审」在提交面拦下 (默认关)
if [ "${AGENTFRAMEWORK_REAUDIT_GUARD:-0}" = "1" ] && [ -f eval/capability/exp1-q32/instruments/reaudit_guard.py ]; then
  RG_ARGS=""
  [ -n "${AGENTFRAMEWORK_REAUDIT_REGISTRY:-}" ] && RG_ARGS="--registry $AGENTFRAMEWORK_REAUDIT_REGISTRY"
  if ! python3 eval/capability/exp1-q32/instruments/reaudit_guard.py --quiet $RG_ARGS; then
    echo "BLOCKED(EXP1-Q32 重审闸): 器具 pin / 记录 pin 与现盘不一致 ⇒ 拒提交。" >&2
    echo "  处置: 跑 python3 eval/capability/bind_evidence.py --only <行> --round <轮> 定向重审后重提交。" >&2
    python3 eval/capability/exp1-q32/instruments/reaudit_guard.py $RG_ARGS 2>&1 | tail -8 >&2
    exit 1
  fi
fi

# EXP1-Q39: 声明一致性闸 + 证据绑定闸 (默认**开**) —— 把「器具改了而 manifest 声明未重审」与
#   「登记表 pin 与现盘不符」在**提交时**拦下 (Q38 实证: 这两类缺陷此前只能靠下一轮真机面偶然抓到)。
#   两闸都**只读** (不写仓内任何字节); 越权关闸: AGENTFRAMEWORK_DECL_SWEEP=0 / AGENTFRAMEWORK_EVIDENCE_CHECK=0
#   (夹具/诊断用; 关闸本身不改变判据, 只跳过)。
if [ "${AGENTFRAMEWORK_DECL_SWEEP:-1}" != "0" ] && [ -f eval/capability/decl_sweep.py ]; then
  DS_LOG="$(mktemp /tmp/decl_sweep_precommit.XXXXXX)"
  if ! python3 eval/capability/decl_sweep.py >"$DS_LOG" 2>&1; then
    echo "BLOCKED(EXP1-Q39 声明一致性闸): instruments.json 声明与现盘字节不符 (器具改了而声明未重审)。" >&2
    echo "  处置: python3 eval/capability/decl_sweep.py --apply   # 只刷 version/instrument_sha12, 判据不放宽" >&2
    echo "  跳过本闸 (夹具/诊断): AGENTFRAMEWORK_DECL_SWEEP=0" >&2
    tail -8 "$DS_LOG" >&2
    rm -f "$DS_LOG"
    exit 1
  fi
  tail -1 "$DS_LOG" >&2
  rm -f "$DS_LOG"
fi
if [ "${AGENTFRAMEWORK_EVIDENCE_CHECK:-1}" != "0" ] && [ -f eval/capability/bind_evidence.py ]; then
  BE_LOG="$(mktemp /tmp/bind_evidence_precommit.XXXXXX)"
  if ! python3 eval/capability/bind_evidence.py --check >"$BE_LOG" 2>&1; then
    echo "BLOCKED(EXP1-Q39 证据绑定闸): 登记表 pin/器具绑定与现盘不符 (R2e/R2f 违规)。" >&2
    echo "  处置: python3 eval/capability/bind_evidence.py --only <行id> --round <轮号> --apply" >&2
    echo "  跳过本闸 (夹具/诊断): AGENTFRAMEWORK_EVIDENCE_CHECK=0" >&2
    grep -m 5 '^VIOLATION' "$BE_LOG" >&2 || tail -5 "$BE_LOG" >&2
    rm -f "$BE_LOG"
    exit 1
  fi
  # EXP1-Q41: 冻结证据漂移作**提交时报文** (不判红; 漂移=0 时本件零输出 ⇒ 干净提交零噪声)
  if [ -f eval/capability/exp1-q41/commit_face_notice_q41.py ]; then
    python3 eval/capability/exp1-q41/commit_face_notice_q41.py --log "$BE_LOG" >&2 || true
  fi
  rm -f "$BE_LOG"
fi

# EXP1-Q40 ④ / EXP1-Q41 **转正**: 提交面「尾 LF 契约」闸 —— 默认**开**。
#   转正依据 (EXP1-Q41 H1..H6 真机回放, 见 docs/plans/v0.22.0-exp1-local-index-and-code-graph.md AN.8):
#     · 全历史回放 (146 个触碰作用面的提交 / 232 blob): 37 处违规**全部**是作用面内件的真实
#       契约违反 (尾 LF 缺失), 无 CRLF/BOM 型, 且**零「合法但被误杀」**样本 ⇒ 误报 = 0;
#     · 现行四个写入器均以 `+ "\n"` 收尾 (bind_evidence:630 / decl_sweep:70 / append_rows_q40:105 /
#       append_instruments_q39:107 / status_gen:143) ⇒ 工具路径不会诱发拦截;
#     · 真仓当前态两态均 rc=0 (机制启用断言: 闸确实跑过, 见 /tmp/tail_lf_precommit.log);
#     · 代价 median 39.9 ms (信息项);
#     · 扩面到全仓**已否决** (200 提交回放: 命中率 59.5%, 主因 1154 `.json` + 237 `.jsonl`
#       产物件写入习惯) ⇒ 作用面维持声明常量 DEFAULT_TARGETS, 不扩。
#   关闸 (诊断/夹具): AGENTFRAMEWORK_TAIL_LF_GUARD=0。
#   契约名与违规原因码**不在此定义** —— 取自 bind_evidence (单一权威源)。
if [ "${AGENTFRAMEWORK_TAIL_LF_GUARD:-1}" != "0" ] && [ -f eval/capability/exp1-q31/instruments/tail_lf_guard.py ]; then
  TL_ARGS=""
  [ -n "${AGENTFRAMEWORK_TAIL_LF_TARGETS:-}" ] && TL_ARGS="--targets ${AGENTFRAMEWORK_TAIL_LF_TARGETS}"
  if ! python3 eval/capability/exp1-q31/instruments/tail_lf_guard.py $TL_ARGS >/tmp/tail_lf_precommit.log 2>&1; then
    echo "BLOCKED(EXP1-Q40 尾 LF 契约闸): 作用面内件的提交态字节不符合规范形 (末字节须 LF; 无 CRLF/BOM)。" >&2
    echo "  处置: 修该件规范形后重提交; 关闸 (诊断): AGENTFRAMEWORK_TAIL_LF_GUARD=0" >&2
    tail -8 /tmp/tail_lf_precommit.log >&2
    exit 1
  fi
fi

# >>> R527 new-file-gate >>>  (新增 .cs 文件结构不变式前置闸; 只在**新增**文件上判, 存量违规不阻塞)
#   关闸 (诊断/夹具): AGENTFRAMEWORK_NEW_FILE_GATE=0
_NFG_ROOT="$(git rev-parse --show-toplevel)"
if [ "${AGENTFRAMEWORK_NEW_FILE_GATE:-1}" != "0" ] && [ -f "$_NFG_ROOT/tools/refactor/new_file_gate.py" ]; then
  if ! python3 "$_NFG_ROOT/tools/refactor/new_file_gate.py" >/tmp/new_file_gate_precommit.log 2>&1; then
    echo "BLOCKED(R527 新增文件结构闸): 新增 .cs 违反单类型单文件/文件名=类型名/ns 与目录一致/括号或 region 配对。" >&2
    echo "  处置: 修该文件结构后重提交; 关闸 (诊断): AGENTFRAMEWORK_NEW_FILE_GATE=0" >&2
    tail -8 /tmp/new_file_gate_precommit.log >&2
    exit 1
  fi
fi

exit 0
