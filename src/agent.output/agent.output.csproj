<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>agent.output</RootNamespace>
    <AssemblyName>agent.output</AssemblyName>
    <Version>0.10.0</Version>
    <Description>Structured output pipeline for agent framework: dual-mode (markdown/plain-text) rendering with Spectre.Console</Description>
    <WarningsAsErrors>nullable</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- v7.13: 控制台美化 (用户钦定第三方库) — Spectre.Console 官方支持 NativeAOT/trimming -->
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
  </ItemGroup>

</Project>
