<Project Sdk="Microsoft.NET.Sdk">

  <!--
    agent.host - AgentFramework 可执行宿主 (AOT 发布冒烟载体)。
    框架本体 (agent 库) 与宿主分离: AOT 只发布宿主, 库以 ProjectReference 参与。
    PublishAot=true + TrimmerSingleWarn=false: 逐程序集暴露裁剪警告, 不互相掩盖。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Version>0.21.0</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>agent.host</RootNamespace>
    <AssemblyName>agenthost</AssemblyName>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <TrimMode>full</TrimMode>
    <!-- v7.15 P3: bge 嵌入器引入 LLamaEmbedder → LLamaSharp 库内部 JSON converter/反射路径触发
         IL2026/IL3050/IL3000。全部 7 处均在 LLamaSharp 程序集内部实现 (非本项目代码),
         运行路径已真机验证 (384 维嵌入正常)。库修复前显式豁免 — 本项目自身代码仍零容忍。 -->
    <NoWarn>$(NoWarn);IL2026;IL3050;IL3000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.10" />
    <!-- v7.13: 控制台美化 (用户钦定第三方库) — Spectre.Console 官方支持 NativeAOT/trimming -->
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../agent/agent.csproj" />
    <ProjectReference Include="../agent.frontendapi/agent.frontendapi.csproj" />
    <ProjectReference Include="../agent.contextgradient/agent.contextgradient.csproj" />
    <ProjectReference Include="..\agent.output\agent.output.csproj" />
    <!-- v0.30.0 R408: llama.cpp 进程化后端 (零 P/Invoke; 进程+HTTP; 跨平台) -->
    <ProjectReference Include="../agent.llamacpp/agent.llamacpp.csproj" />
  </ItemGroup>

<!--
    R371 D2 (发布自包含): AOT 产物必须自带 config/base, 否则从仓库外任意 cwd 运行都报
    "模型目录为空" (真机实证: 在 /tmp 下运行发布产物)。运行时层 config/runtime 不随包
    (由部署侧可写目录生成); 凭据只存环境变量名, 无明文值 (凭据卫生)。
  -->
  <ItemGroup>
    <None Include="../../config/base/**/*"
          Link="config/base/%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../config/modules/**/*"
          Link="config/modules/%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../config/env/**/*"
          Link="config/env/%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
