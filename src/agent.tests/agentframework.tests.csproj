<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <DefineConstants Condition="'$(DisableSkiaRenderer)' != 'true'">$(DefineConstants);SKIA_RENDERER</DefineConstants>
    <TargetFramework>net10.0</TargetFramework>
    <Version>0.21.0</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- R402 步 2: 同源编译的 CpuKernels 含 unsafe 指针窗口 (mmap 零拷贝并行 GEMV) -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.0" />
    <PackageReference Include="Moq" Version="4.20.70" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <!-- R402: 归因读数辅助 (纯 BCL / 零依赖) —— 只被测试使用, 故**只在此处**编译,
         不放进 agent.csproj 共享源: 产品程序集(AOT 产物)不应含测试专用类型。 -->
    <Compile Include="../agent.rover/runtime/ProcIo.cs" Link="rover-runtime/%(Filename)%(Extension)" />
    <!-- R402 步 2: 计算内核 (反量化 + GEMV) 与量化块布局 —— 同源编译, 与 agent.rover 里的**同一份代码**,
         避免"测试影子实现"。依赖: GgmlType(枚举+块布局) → Dequant → CpuKernels; TensorPrimitives 由包引用提供。 -->
    <Compile Include="../agent.rover/gguf/GgmlType.cs" Link="rover-gguf/%(Filename)%(Extension)" />
    <Compile Include="../agent.rover/quant/Dequant.cs" Link="rover-quant/%(Filename)%(Extension)" />
    <Compile Include="../agent.rover/runtime/CpuKernels.cs" Link="rover-runtime/%(Filename)%(Extension)" />
    <!-- R403: RoPE 配对约定 (arch→NORM/NEOX) 与其预计算表 —— 静默错误高危点, 需金标向量+负控测试,
         故与产品侧同源编译 (同一份代码, 不是影子实现)。依赖: RopePairing → RopeTable。 -->
    <Compile Include="../agent.rover/infer/RopePairing.cs" Link="rover-infer/%(Filename)%(Extension)" />
    <Compile Include="../agent.rover/infer/RopeTable.cs" Link="rover-infer/%(Filename)%(Extension)" />
    <!-- R407: qwen2 前向对账第一站 —— attn bias 层归属。需要真 GgufReader/ModelConfig/ForwardPass
         (同源编译, 同一份代码; 不接受"测试影子实现")。依赖链:
         GgmlType→GgufMappedFile→GgufReader→ModelConfig→(Dequant+CpuKernels+TensorResidency)→ForwardPass。 -->
    <Compile Include="../agent.rover/gguf/GgufMappedFile.cs" Link="rover-gguf/%(Filename)%(Extension)" />
    <Compile Include="../agent.rover/gguf/GgufReader.cs" Link="rover-gguf/%(Filename)%(Extension)" />
    <Compile Include="../agent.rover/runtime/TensorResidency.cs" Link="rover-runtime/%(Filename)%(Extension)" />
    <Compile Include="../agent.rover/infer/ModelConfig.cs" Link="rover-infer/%(Filename)%(Extension)" />
    <Compile Include="../agent.rover/infer/KvCache.cs" Link="rover-infer/%(Filename)%(Extension)" />
    <Compile Include="../agent.rover/infer/ForwardPass.cs" Link="rover-infer/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- 与 agent.rover 同版本, 供同源编译的 CpuKernels 使用 -->
    <PackageReference Include="System.Numerics.Tensors" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../agent/agent.csproj" />
    <ProjectReference Include="../agent.gpu/agent.gpu.csproj" />
    <ProjectReference Include="../agent.frontendapi/agent.frontendapi.csproj" />
    <ProjectReference Include="../agent.roles/agent.roles.csproj" />
    <ProjectReference Include="../agent.config/agent.config.csproj" />
    <ProjectReference Include="../agent.exploration/agent.exploration.csproj" />
    <ProjectReference Include="../agent.io/agent.io.csproj" />
    <ProjectReference Include="../agent.core/agent.core.csproj" />
    <ProjectReference Include="../agent.rag/agent.rag.csproj" />
    <ProjectReference Include="../agent.codegen/agent.codegen.csproj" />
    <ProjectReference Include="../agent.vectormemory/agent.vectormemory.csproj" />
    <ProjectReference Include="../agent.workspace/agent.workspace.csproj" />
    <ProjectReference Include="../agent.recovery/agent.recovery.csproj" />
    <ProjectReference Include="..\agent.output\agent.output.csproj" />
  </ItemGroup>

</Project>
