<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <DefineConstants Condition="'$(DisableSkiaRenderer)' != 'true'">$(DefineConstants);SKIA_RENDERER</DefineConstants>
    <Version>0.21.0</Version>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- R402 步 2: 同源编译的 CpuKernels 含 unsafe 指针窗口 (mmap 零拷贝并行 GEMV) -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Moq" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <!-- R408 (用户钦定: 本地 GGUF 引擎整线退役 → llama.cpp 进程化接入):
         rover gguf/quant/infer/runtime 的同源编译登记**全部移除** (被撤代码已删), 仅保留产品侧
         真正依赖的 formal/ + gpu/spirv/ (由 agent.csproj 共享源编译)。
         R402/R403/R407 的对账测试随自研前向一并退役; 数值对账口径改为「对 llama.cpp 官方实现」。 -->
  </ItemGroup>

  <ItemGroup>
    <!-- 与 agent.rover 同版本, 供同源编译的 CpuKernels 使用 -->
    <PackageReference Include="System.Numerics.Tensors" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../agent/agent.csproj" />
    <ProjectReference Include="../agent.llamacpp/agent.llamacpp.csproj" />
    <ProjectReference Include="../agent.gpu/agent.gpu.csproj" />
    <ProjectReference Include="../agent.frontendapi/agent.frontendapi.csproj" />
    <ProjectReference Include="../agent.roles/agent.roles.csproj" />
    <ProjectReference Include="../agent.config/agent.config.csproj" />
    <ProjectReference Include="../agent.exploration/agent.exploration.csproj" />
    <ProjectReference Include="../agent.io/agent.io.csproj" />
    <ProjectReference Include="../agent.core/agent.core.csproj" />
    <ProjectReference Include="../agent.rag/agent.rag.csproj" />
    <ProjectReference Include="../agent.codegen/agent.codegen.csproj" />
    <ProjectReference Include="../agent.vectormemory/agent.vectormemory.csproj" />
    <ProjectReference Include="../agent.workspace/agent.workspace.csproj" />
    <ProjectReference Include="../agent.recovery/agent.recovery.csproj" />
    <ProjectReference Include="..\agent.output\agent.output.csproj" />
  </ItemGroup>

</Project>
