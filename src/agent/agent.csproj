<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>agent</RootNamespace>
    <AssemblyName>agent</AssemblyName>
    <Version>0.21.0</Version>
    <Authors>agent Team</Authors>
    <Description>Enterprise-grade intelligent Agent framework with WebReaper integration</Description>
    <Copyright>Copyright 2026</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <!-- 工业级 AOT 前置: 可空警告升级为错误, 禁止隐式反射序列化 -->
    <WarningsAsErrors>nullable</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft Extensions (net10.0 对齐) -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <!-- WebReaper 库直引 (net10.0 对齐): 搜索结果全文增强引擎 (AOT clean, 上游 CLI 同链路自证) -->
    <PackageReference Include="WebReaper" />
    <!-- Serialization: System.Text.Json 内置于 net10.0 (AOT source-gen, 零反射) -->
    <!-- Regex: GeneratedRegex source generator (AOT 零反射) -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../agent.core/agent.core.csproj" />
    <ProjectReference Include="../agent.exploration/agent.exploration.csproj" />
    <ProjectReference Include="../agent.rag/agent.rag.csproj" />
    <ProjectReference Include="../agent.codegen/agent.codegen.csproj" />
    <ProjectReference Include="../agent.vectormemory/agent.vectormemory.csproj" />
    <ProjectReference Include="../agent.workspace/agent.workspace.csproj" />
    <ProjectReference Include="../agent.recovery/agent.recovery.csproj" />
    <ProjectReference Include="../agent.config/agent.config.csproj" />
    <ProjectReference Include="../agent.modelqueue/agent.modelqueue.csproj" />
    <ProjectReference Include="../agent.roles/agent.roles.csproj" />
    <ProjectReference Include="../agent.logging/agent.logging.csproj" />
    <ProjectReference Include="../agent.skills/agent.skills.csproj" />
    <ProjectReference Include="../agent.contextgradient/agent.contextgradient.csproj" />
    <!-- v0.30.0 R408 (用户钦定: 本地 GGUF 引擎整线退役 → llama.cpp 进程化接入):
         本地推理由 agent.llamacpp 提供 —— 零 P/Invoke 的「进程 + loopback HTTP」边界 (跨平台)。
         原 ../agent.embedcpu (纯托管 BERT 前向) 退役。 -->
    <ProjectReference Include="../agent.llamacpp/agent.llamacpp.csproj" />
    <!-- 闸族系重建 (用户令 2026-09-19): nlp -> 结构化数据 -> 闸族系 -> 本地执行。
         判定依据一律走 agent.nlp (fastText 语言标签 + o200k 分词), 不再有中文词表。 -->
    <ProjectReference Include="../agent.nlp/agent.nlp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- v0.23.0 exp12 · S2: agent.rover 形式化内核共享源 (纯 BCL / 零反射 / 无 NuGet 依赖, 与 CLI 同源编译),
         使「节点级闸门」在 agent 进程内零 token 判定, 不起子进程、不走 shell。 -->
    <Compile Include="../agent.rover/formal/*.cs" Link="formal/%(Filename)%(Extension)" />
    <!-- v0.23.0 exp12 · vulkan: agent.rover SPIR-V 汇编器 + 内核目录 + **独立结构校验器** (同为纯 BCL),
         使 GPU 内核可被 agent 进程内静态校验 (机检), 不引入 Silk.NET 依赖 (主机侧仅 CLI 引用)。 -->
    <Compile Include="../agent.rover/gpu/spirv/*.cs" Link="gpu/spirv/%(Filename)%(Extension)" />
    <!-- R408: rover 分词/ChatTemplate (rover-token) 与 Sampler 的共享源登记已移除 ——
         产品侧对它们的引用数为 0 (机检), 且分词/聊天模板自 R408 起交 llama.cpp (jinja 模式)。 -->
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="agentframework.tests" />
  </ItemGroup>

</Project>
