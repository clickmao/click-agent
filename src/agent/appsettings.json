{
  "AgentFramework": {
    "Agent": {
      "Name": "MainAgent",
      "MaxTokenBudget": 100000,
      "DefaultTimeout": 300000,
      "MaxSubAgents": 4
    },
    "Memory": {
      "LongTerm": {
        "Provider": "File",
        "Path": "./data/memory",
        "IndexEnabled": true
      },
      "ShortTerm": {
        "MaxEntries": 1000,
        "SummarizeAfterTurns": 10
      }
    },
    "Template": {
      "StoragePath": "./data/templates",
      "AutoSave": true,
      "SuccessRateThreshold": 0.8
    },
    "Search": {
      "Provider": "WebReaper",
      "Endpoint": "http://localhost:8080",
      "CacheEnabled": true,
      "CacheDurationSeconds": 3600,
      "MaxResults": 10
    },
    "MAF": {
      "Enabled": false,
      "Endpoint": "http://localhost:5000",
      "ApiKey": "${MAF_API_KEY}"
    },
    "Session": {
      "AutoSave": true,
      "SaveIntervalSeconds": 60,
      "MaxConcurrentSessions": 100
    },
    "Tendency": {
      "Enabled": true,
      "UpdateIntervalSeconds": 5,
      "MinSampleSize": 10
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "AgentFramework": "Debug"
    },
    "Console": {
      "Enabled": true,
      "IncludeScopes": true
    }
  }
}
