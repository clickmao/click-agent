         替代自研 MiniYaml 子集实现 — YAML 1.2 全规范 (锚点/流式/块标量等), DOM 弱类型树输出兼容。 -->
    <PackageReference Include="Yamlify" Version="1.8.0" />
  </ItemGroup>
</Project>
