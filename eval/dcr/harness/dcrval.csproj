<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>dcrval</AssemblyName>
    <RootNamespace>dcrval</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0414;CS0169</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- 只编译 harness 自身 + 仓库内**只读**共享源 (绝不修改 src/**) -->
    <Compile Include="Stubs.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../../../src/click-rover/Formal/*.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../../../src/agent/registry/FormalAssertionContract.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../../../src/agent/intent/PlanNodeFormalGate.cs" />
  </ItemGroup>
</Project>
