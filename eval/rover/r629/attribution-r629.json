     {
      "line": 8,
      "text": "    # losing positions: (floor(k*phi), floor(k*phi^2))"
     },
     {
      "line": 9,
      "text": "    PHI = (1 + 5 ** 0.5) / 2"
     },
     {
      "line": 10,
      "text": "    losing = set()"
     },
     {
      "line": 11,
      "text": "    k = 0"
     },
     {
      "line": 12,
      "text": "    while True:"
     },
     {
      "line": 13,
      "text": "        x = int(k * PHI) + k  # floor(k*phi^2) == floor(k*phi) + k"
     },
     {
      "line": 14,
      "text": "        y = int(k * PHI)"
     },
     {
      "line": 15,
      "text": "        if x > 25 and y > 25:"
     },
     {
      "line": 16,
      "text": "            break"
     },
     {
      "line": 17,
      "text": "        losing.add((y, x))"
     },
     {
      "line": 18,
      "text": "        losing.add((x, y))"
     },
     {
      "line": 19,
      "text": "        k += 1"
     },
     {
      "line": 20,
      "text": "        if k > 1000:"
     },
     {
      "line": 21,
      "text": "            break"
     },
     {
      "line": 22,
