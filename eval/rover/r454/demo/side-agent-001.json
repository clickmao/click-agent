{
 "side": "agent",
 "request": {
  "path": "/v1/chat/completions",
  "n_messages": 1,
  "upstream_request": {
   "model": "deepseek-chat",
   "messages": [
    {
     "role": "user",
     "content": "只回两个字: 收到"
    }
   ],
   "stream": false,
   "max_tokens": 20
  }
 },
 "response": {
  "model": "deepseek-flash",
  "text": "收到",
  "usage": {
   "prompt_tokens": 10,
   "completion_tokens": 1,
   "total_tokens": 11,
   "prompt_tokens_details": {
    "cached_tokens": 0
   },
   "prompt_cache_hit_tokens": 0,
   "prompt_cache_miss_tokens": 10
  }
 },
 "extra": {}
}