#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""终端文本贪吃蛇（单文件）。

设计约束：逻辑与渲染严格分离
    SnakeGame  —— 纯逻辑（不 import 任何打印/终端控制代码），可无头自测；
    Renderer   —— 只读 SnakeGame 的公开状态，负责文本 + ANSI 输出；
    KeyReader  —— 只把终端按键翻译成逻辑动作（up/down/left/right/pause/quit/restart）。

用法：
    python3 game.py                     # 开始游戏
    python3 game.py --selftest          # 无头自测，打印 PASS / FAIL（退出码 0/1）
    python3 game.py --width 40 --height 20 --speed 12 --seed 42
    python3 game.py --no-color
操作：
    方向键 或 W/A/S/D（或 H/J/K/L）移动，P/空格 暂停，Q 退出，结束后 R 重开。

棋盘最小尺寸为 5x5（保证初始三节蛇身可放下）。
"""

import argparse
import contextlib
import io
import os
import random
import select
import sys
import time

# ============================================================ 逻辑层（无 I/O）

DIRECTIONS = {"up": (0, -1), "down": (0, 1), "left": (-1, 0), "right": (1, 0)}
OPPOSITE = {"up": "down", "down": "up", "left": "right", "right": "left"}

MIN_SIDE = 5  # 小于该边长时初始三节蛇身无法摆放


class SnakeGame:
    """纯逻辑贪吃蛇：无打印、无终端依赖，可用固定随机源做确定性测试。"""

    def __init__(self, width=30, height=16, rng=None):
        if width < MIN_SIDE or height < MIN_SIDE:
            raise ValueError("棋盘至少 %dx%d" % (MIN_SIDE, MIN_SIDE))
        self.width = int(width)
        self.height = int(height)
        self.rng = rng if rng is not None else random.Random()
        self.reset()

    # -------------------------------------------------- 状态
    def reset(self):
        cx, cy = self.width // 2, self.height // 2
        self.snake = [(cx, cy), (cx - 1, cy), (cx - 2, cy)]  # 头在 index 0
        self.direction = "right"
        self._turns = []          # 待生效转向队列（最多 2 个，避免同一 tick 丢输入）
        self.score = 0
        self.game_over = False
        self.won = False
        self.food = None
        self._spawn_food()

    @property
    def head(self):
        return self.snake[0]

    def occupied(self):
        return set(self.snake)

    # -------------------------------------------------- 输入
    def set_direction(self, new_direction):
        """接受一次转向；禁止 180° 掉头与重复方向。返回是否被接受。"""
        if new_direction not in DIRECTIONS:
            raise ValueError("未知方向: %r" % (new_direction,))
        base = self._turns[-1] if self._turns else self.direction
        if new_direction == base or new_direction == OPPOSITE[base]:
            return False
        if len(self._turns) >= 2:
            return False
        self._turns.append(new_direction)
        return True

    # -------------------------------------------------- 推进
    def step(self):
        """推进一步，返回事件：'move' | 'eat' | 'win' | 'dead' | 'idle'。"""
        if self.game_over or self.won:
            return "idle"
        if self._turns:
            self.direction = self._turns.pop(0)

        dx, dy = DIRECTIONS[self.direction]
        nx, ny = self.head[0] + dx, self.head[1] + dy

        if not (0 <= nx < self.width and 0 <= ny < self.height):
            self.game_over = True
            return "dead"

        eating = (nx, ny) == self.food
        # 不进食时尾巴会移开，撞尾巴不算死；进食时尾巴不动，算死。
        body = self.snake if eating else self.snake[:-1]
        if (nx, ny) in body:
            self.game_over = True
            return "dead"

        self.snake.insert(0, (nx, ny))
        if not eating:
            self.snake.pop()
            return "move"

        self.score += 1
        self._spawn_food()
        return "win" if self.won else "eat"

    def _spawn_food(self):
        free = [(x, y) for y in range(self.height) for x in range(self.width)
                if (x, y) not in self.snake]
        if not free:
            self.food = None
            self.won = True
            return
        self.food = self.rng.choice(free)


# ============================================================ 渲染层（只读状态）

def _is_tty(stream):
    try:
        return bool(stream.isatty())
    except Exception:
        return False


class Renderer:
    """把 SnakeGame 的状态画成文本/ANSI，不修改任何游戏状态。"""

    GLYPHS = {"wall": "#", "head": "O", "body": "o", "food": "*", "empty": " "}
    STYLES = {"wall": "\033[90m", "head": "\033[1;32m",
              "body": "\033[32m", "food": "\033[1;31m"}

    def __init__(self, stream=None, color=None, clear=True):
        self.stream = stream if stream is not None else sys.stdout
        if color is None:
            color = _is_tty(self.stream) and os.environ.get("TERM", "") != "dumb"
        self.color = bool(color)
        self.clear = bool(clear)

    def _paint(self, kind):
        ch = self.GLYPHS[kind]
        if not self.color or kind == "empty":
            return ch
        return self.STYLES[kind] + ch + "\033[0m"

    def draw(self, game, status=""):
        cells = {}
        if game.food is not None:
            cells[game.food] = "food"
        for i, pos in enumerate(game.snake):
            cells[pos] = "head" if i == 0 else "body"

        wall = self._paint("wall")
        lines = [wall * (game.width + 2)]
        for y in range(game.height):
            row = "".join(self._paint(cells.get((x, y), "empty"))
                          for x in range(game.width))
            lines.append(wall + row + wall)
        lines.append(wall * (game.width + 2))
        if status:
            lines.append(status)

        payload = "\n".join(lines) + "\n"
        if self.clear:
            payload = "\033[H\033[J" + payload
        self.stream.write(payload)
        self.stream.flush()


# ============================================================ 输入层

ARROW_SEQUENCES = {"\x1b[A": "up", "\x1b[B": "down",
                   "\x1b[C": "right", "\x1b[D": "left"}
WIN_ARROW_CODES = {"H": "\x1b[A", "P": "\x1b[B", "M": "\x1b[C", "K": "\x1b[D"}
KEY_ACTIONS = {
    "w": "up", "k": "up", "a": "left", "h": "left",
    "s": "down", "j": "down", "d": "right", "l": "right",
    "q": "quit", "\x03": "quit", "p": "pause", " ": "pause", "r": "restart",
}


class KeyReader:
    """非阻塞按键读取，统一翻译为逻辑动作（POSIX 用 termios，Windows 用 msvcrt）。"""

    def __init__(self):
        self._fd = None
        self._saved = None
        self._nt = (os.name == "nt")

    def __enter__(self):
        if self._nt or sys.stdin is None or not _is_tty(sys.stdin):
            return self
        try:
            import termios
            import tty
        except ImportError:               # pragma: no cover - 平台相关
            return self
        try:
            self._fd = sys.stdin.fileno()
            self._saved = termios.tcgetattr(self._fd)
            tty.setcbreak(self._fd)
        except Exception:                 # pragma: no cover - 平台相关
            self._fd = None
            self._saved = None
        return self

    def __exit__(self, exc_type, exc, tb):
        self.restore()
        return False

    def restore(self):
        if self._fd is not None and self._saved is not None:
            try:
                import termios
                termios.tcsetattr(self._fd, termios.TCSADRAIN, self._saved)
            except Exception:             # pragma: no cover - 平台相关
                pass
        self._fd = None
        self._saved = None

    # -------------------------------------------------- 读取
    def _read_char(self, timeout=0.0):
        """读一个字符；无输入返回 None（Windows 走 msvcrt）。"""
        if self._nt:                      # pragma: no cover - 平台相关
            import msvcrt
            deadline = time.monotonic() + timeout
            while True:
                if msvcrt.kbhit():
                    return msvcrt.getwch()
                if time.monotonic() >= deadline:
                    return None
                time.sleep(0.005)
        try:
            ready, _, _ = select.select([sys.stdin], [], [], timeout)
        except Exception:
            return None
        if not ready:
            return None
        ch = sys.stdin.read(1)
        return ch if ch else None

    def poll(self, timeout=0.0):
        """返回一个逻辑动作（str），无输入返回 None。"""
        if not self._nt and self._fd is None:
            return None
        ch = self._read_char(timeout)
        if ch is None:
            return None
        return self._decode(ch)

    # -------------------------------------------------- 翻译
    def _decode(self, ch):
        if ch == "\x1b":
            seq = ch
            for _ in range(2):            # 方向键为 ESC [ X 三字节
                more = self._read_char(0.01)
                if more is None:
                    break
                seq += more
            action = ARROW_SEQUENCES.get(seq)
            if action is not None:
                return action
            if len(seq) == 1:
                return None               # 单独的 ESC：忽略
            return KEY_ACTIONS.get(seq[-1].lower())

        if ch in ("\x00", "\xe0"):        # Windows 方向键前缀
            nxt = self._read_char(0.05)
            if nxt is None:
                return None
            return KEY_ACTIONS.get(WIN_ARROW_CODES.get(nxt.upper(), ""), None)

        return KEY_ACTIONS.get(ch.lower() if ch.isalpha() else ch)


# ============================================================ 无头自测

def run_selftest():
    """逻辑层自测：不依赖终端，全部通过返回 True。"""
    results = []

    def check(name, cond):
        results.append((name, bool(cond)))
        return bool(cond)

    # ---- 初始状态
    g = SnakeGame(8, 6, random.Random(0))
    check("初始蛇长 3", len(g.snake) == 3)
    check("初始未结束", not g.game_over and not g.won)
    check("食物不在蛇身上", g.food not in g.occupied())
    contiguous = all(
        abs(g.snake[i][0] - g.snake[i + 1][0]) +
        abs(g.snake[i][1] - g.snake[i + 1][1]) == 1
        for i in range(len(g.snake) - 1))
    check("蛇身连续且头在前", contiguous and g.head == g.snake[0])

    # ---- 基本移动
    hx, hy = g.head
    check("step 返回 move", g.step() == "move")
    check("向右前进一格", g.head == (hx + 1, hy))

    # ---- 转向规则
    check("拒绝 180° 掉头", g.set_direction("left") is False)
    check("接受 90° 转向", g.set_direction("up") is True)
    check("转向在下一步生效", g.direction == "right")

    # ---- 进食
    g2 = SnakeGame(8, 6, random.Random(1))
    g2.snake = [(3, 3), (2, 3), (1, 3)]
    g2.direction = "right"
    g2._turns = []
    g2.food = (4, 3)
    check("吃食物返回 eat", g2.step() == "eat")
    check("进食后蛇长 +1", len(g2.snake) == 4)
    check("进食后得分 +1", g2.score == 1)
    check("新食物不在蛇身上", g2.food is not None and g2.food not in g2.occupied())

    # ---- 撞墙
    g3 = SnakeGame(8, 6, random.Random(2))
    g3.snake = [(7, 3), (6, 3), (5, 3)]
    g3.direction = "right"
    g3._turns = []
    g3.food = (0, 0)
    check("撞墙判定死亡", g3.step() == "dead" and g3.game_over)

    # ---- 撞自己
    g4 = SnakeGame(8, 6, random.Random(3))
    g4.snake = [(3, 3), (3, 4), (2, 4), (2, 3), (2, 2)]
    g4.direction = "down"
    g4._turns = []
    g4.food = (0, 0)
    check("撞自己判定死亡", g4.step() == "dead" and g4.game_over)
    check("死亡后 step 为 idle", g4.step() == "idle")

    # ---- 逻辑层零输出
    buf = io.StringIO()
    with contextlib.redirect_stdout(buf):
        gz = SnakeGame(8, 6, random.Random(4))
        for _ in range(5):
            gz.step()
        gz.set_direction("up")
        gz.reset()
    check("逻辑层零输出", buf.getvalue() == "")

    ok = True
    for name, passed in results:
        print("[ok] %s" % name if passed else "[FAIL] %s" % name)
        ok = ok and passed

    print("PASS" if ok else "FAIL")
    return ok


# ============================================================ 命令行入口

def parse_args(argv=None):
    p = argparse.ArgumentParser(description="终端文本贪吃蛇")
    p.add_argument("--selftest", action="store_true", help="无头自测后退出")
    p.add_argument("--width", type=int, default=30, help="棋盘宽（>=%d）" % MIN_SIDE)
    p.add_argument("--height", type=int, default=16, help="棋盘高（>=%d）" % MIN_SIDE)
    p.add_argument("--speed", type=float, default=8.0, help="每秒步数")
    p.add_argument("--seed", type=int, default=None, help="随机种子")
    p.add_argument("--no-color", action="store_true", help="禁用 ANSI 颜色")
    return p.parse_args(argv)


def main(argv=None):
    args = parse_args(argv)

    if args.selftest:
        return 0 if run_selftest() else 1

    rng = random.Random(args.seed) if args.seed is not None else random.Random()
    try:
        game = SnakeGame(max(MIN_SIDE, args.width), max(MIN_SIDE, args.height), rng)
    except ValueError as exc:
        print("参数错误: %s" % exc, file=sys.stderr)
        return 2

    renderer = Renderer(color=False if args.no_color else None)
    delay = 1.0 / max(1.0, float(args.speed))
    paused = False
    next_tick = time.monotonic() + delay

    def status_text():
        if game.won:
            return "恭喜通关！得分 %d — R 重开，Q 退出" % game.score
        if game.game_over:
            return "游戏结束 — 得分 %d — R 重开，Q 退出" % game.score
        if paused:
            return "已暂停 — 得分 %d — P 继续，Q 退出" % game.score
        return "得分 %d — 方向键/WASD 移动，P 暂停，Q 退出" % game.score

    try:
        with KeyReader() as keys:
            while True:
                action = keys.poll(0.0)
                while action is not None:
                    if action == "quit":
                        return 0
                    if action == "pause":
                        paused = not paused
                    elif action == "restart":
                        game.reset()
                        paused = False
                        next_tick = time.monotonic() + delay
                    elif action in DIRECTIONS:
                        if not (paused or game.game_over or game.won):
                            game.set_direction(action)
                    action = keys.poll(0.0)

                now = time.monotonic()
                if not paused and now >= next_tick:
                    game.step()
                    next_tick = now + delay
                    if game.game_over or game.won:
                        paused = True

                renderer.draw(game, status_text())
                time.sleep(0.01)
    except KeyboardInterrupt:
        return 0


if __name__ == "__main__":
    sys.exit(main())
