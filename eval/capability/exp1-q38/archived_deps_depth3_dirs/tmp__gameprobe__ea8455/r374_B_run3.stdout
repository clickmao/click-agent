#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
终端贪吃蛇（单文件）。

分层：
  SnakeGame         纯逻辑层：不读终端、不打印，可无头测试
  TerminalRenderer  纯渲染层：把逻辑状态转成文本帧，不做规则判断
  run_game()        主循环：把逻辑 + 渲染 + 键盘接起来
  run_selftest()    无头自测：python3 game.py --selftest  ->  PASS / FAIL
"""
from __future__ import annotations

import argparse
import contextlib
import os
import random
import sys
import time
from collections import deque

# ---------------- 常量 ----------------
UP, DOWN, LEFT, RIGHT = (0, -1), (0, 1), (-1, 0), (1, 0)
OPPOSITE = {UP: DOWN, DOWN: UP, LEFT: RIGHT, RIGHT: LEFT}

SNAKE_HEAD = '@'
SNAKE_BODY = 'o'
FOOD = '*'
EMPTY = ' '

ARROW_KEYS = {'[A': 'w', '[B': 's', '[C': 'd', '[D': 'a'}


# ---------------- 逻辑层 ----------------
class SnakeGame:
    """纯逻辑：只维护状态，不产生任何 I/O。"""

    def __init__(self, width=24, height=12, start=None, direction=RIGHT,
                 initial_length=3, rng=None):
        if width < 3 or height < 3:
            raise ValueError('网格至少 3x3')
        self.width = width
        self.height = height
        self.rng = rng if rng is not None else random.Random()
        self.direction = direction
        self.alive = True
        self.score = 0
        self.steps = 0

        if start is None:
            start = (width // 2, height // 2)
        initial_length = max(1, min(initial_length, width - 1, height - 1))

        # body[0] 为蛇头，body[-1] 为蛇尾
        self.body = deque()
        for i in range(initial_length):
            self.body.append((start[0] - direction[0] * i,
                              start[1] - direction[1] * i))
        self.food = None
        self.spawn_food()

    # --- 状态变更 ---
    def turn(self, direction):
        """改变方向；忽略 180° 反向与重复方向。"""
        if direction == self.direction or direction == OPPOSITE.get(self.direction):
            return False
        self.direction = direction
        return True

    def spawn_food(self):
        """在非蛇身格子中随机放食物；棋盘满则食物为 None。"""
        occupied = set(self.body)
        free = [(x, y) for y in range(self.height) for x in range(self.width)
                if (x, y) not in occupied]
        self.food = self.rng.choice(free) if free else None
        return self.food

    def set_food(self, pos):
        """显式放置食物，供确定性测试使用。"""
        self.food = (int(pos[0]), int(pos[1]))
        return self.food

    def step(self):
        """推进一步。返回 True 表示本步后仍存活。"""
        if not self.alive:
            return False

        hx, hy = self.body[0]
        nx, ny = hx + self.direction[0], hy + self.direction[1]

        # 撞墙
        if not (0 <= nx < self.width and 0 <= ny < self.height):
            self.alive = False
            return False

        will_eat = (self.food is not None and (nx, ny) == self.food)
        # 不吃食物时蛇尾本步会腾空，该格不算碰撞
        occupied = set(self.body) if will_eat else set(list(self.body)[:-1])
        if (nx, ny) in occupied:
            self.alive = False
            return False

        self.body.appendleft((nx, ny))
        if will_eat:
            self.score += 1
            self.spawn_food()
        else:
            self.body.pop()
        self.steps += 1
        return True


# ---------------- 渲染层 ----------------
class TerminalRenderer:
    """纯渲染：把 SnakeGame 的状态转成文本帧，不修改逻辑状态。"""

    def __init__(self, game):
        self.game = game

    def frame(self):
        g = self.game
        grid = [[EMPTY] * g.width for _ in range(g.height)]
        for i, (x, y) in enumerate(g.body):
            if 0 <= x < g.width and 0 <= y < g.height:
                grid[y][x] = SNAKE_HEAD if i == 0 else SNAKE_BODY
        if g.food is not None:
            fx, fy = g.food
            if 0 <= fx < g.width and 0 <= fy < g.height:
                grid[fy][fx] = FOOD

        border = '+' + '-' * g.width + '+'
        lines = [border]
        lines += ['|' + ''.join(row) + '|' for row in grid]
        lines.append(border)
        state = 'ALIVE' if g.alive else 'DEAD'
        lines.append(f'Score: {g.score:<4} Steps: {g.steps:<5} {state}   [WASD/hjkl] move  [q] quit')
        return '\n'.join(lines)


# ---------------- 终端输入 ----------------
@contextlib.contextmanager
def raw_mode():
    """cbreak 模式逐键读取；非 tty 或 Windows 下空操作。"""
    if os.name == 'nt' or not sys.stdin.isatty():
        yield
        return
    import termios
    import tty
    fd = sys.stdin.fileno()
    saved = termios.tcgetattr(fd)
    try:
        tty.setcbreak(fd)
        yield
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, saved)


def read_key(timeout):
    """等待 timeout 秒；有按键返回单个字符，否则返回 None。"""
    if os.name == 'nt':
        import msvcrt
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            if msvcrt.kbhit():
                return msvcrt.getwch()
            time.sleep(0.005)
        return None
    if not sys.stdin.isatty():          # 管道 / CI：无输入，按帧率空转
        time.sleep(timeout)
        return None
    import select
    ready, _, _ = select.select([sys.stdin], [], [], timeout)
    if ready:
        return sys.stdin.read(1)
    return None


def _normalize_key(key):
    """把方向键的 ESC 序列归一成 wasd，其它情况原样返回。"""
    if key != '\x1b':
        return key
    tail = (read_key(0.001) or '') + (read_key(0.001) or '')
    return ARROW_KEYS.get(tail)


# ---------------- 主循环 ----------------
def run_game(width, height, fps):
    game = SnakeGame(width=width, height=height)
    renderer = TerminalRenderer(game)
    keymap = {'w': UP, 's': DOWN, 'a': LEFT, 'd': RIGHT,
              'k': UP, 'j': DOWN, 'h': LEFT, 'l': RIGHT}
    frame_time = 1.0 / max(1.0, fps)

    with raw_mode():
        sys.stdout.write('\x1b[2J\x1b[?25l')   # 清屏 + 隐藏光标
        sys.stdout.flush()
        try:
            while True:
                sys.stdout.write('\x1b[H' + renderer.frame() + '\n')
                sys.stdout.flush()
                if not game.alive:
                    break
                key = _normalize_key(read_key(frame_time))
                if key is not None:
                    if key in ('q', '\x03'):   # q / Ctrl-C
                        break
                    if key in keymap:
                        game.turn(keymap[key])
                game.step()
        except KeyboardInterrupt:
            pass
        finally:
            sys.stdout.write('\x1b[?25h\n')
            sys.stdout.flush()

    print(f'Game over. score={game.score} steps={game.steps} length={len(game.body)}')
    return 0


# ---------------- 无头自测 ----------------
def run_selftest():
    checks = []

    def check(name, ok):
        checks.append((name, bool(ok)))

    # 1) 前进
    g = SnakeGame(width=10, height=6, start=(4, 3), direction=RIGHT,
                  initial_length=3, rng=random.Random(1))
    g.set_food((0, 0))
    g.step()
    check('step 沿当前方向前进一格', g.body[0] == (5, 3))
    check('未吃食物时长度不变', len(g.body) == 3)

    # 2) 转向生效 / 忽略反向
    g.turn(UP)
    check('turn 改变方向', g.direction == UP)
    g.step()
    check('转向后沿新方向前进', g.body[0] == (5, 2))
    g.turn(DOWN)
    check('忽略 180 度反向', g.direction == UP)

    # 3) 吃食物
    g = SnakeGame(width=10, height=6, start=(2, 2), direction=RIGHT,
                  initial_length=3, rng=random.Random(2))
    g.set_food((3, 2))
    g.step()
    check('吃到食物 score +1', g.score == 1)
    check('吃到食物长度 +1', len(g.body) == 4)
    check('吃后食物重生且不在蛇身上',
          g.food is not None and g.food not in set(g.body))

    # 4) 撞墙（负向对照：删掉边界判断该用例必红）
    g = SnakeGame(width=5, height=5, start=(3, 2), direction=RIGHT,
                  initial_length=1, rng=random.Random(3))
    g.set_food((0, 0))
    g.step()
    check('未出界时存活', g.alive and g.body[0] == (4, 2))
    g.step()
    check('撞右墙死亡', not g.alive)

    # 5) 撞自身
    g = SnakeGame(width=10, height=10, start=(5, 5), direction=RIGHT,
                  initial_length=5, rng=random.Random(4))
    g.set_food((9, 9))
    g.turn(UP); g.step()
    g.turn(LEFT); g.step()
    g.turn(DOWN); g.step()
    check('撞自身死亡', not g.alive)

    # 6) 死亡后冻结
    frozen_head = g.body[0]
    g.step()
    check('死亡后状态冻结', g.body[0] == frozen_head and not g.alive)

    # 7) 渲染层
    g = SnakeGame(width=8, height=4, start=(3, 1), direction=RIGHT,
                  initial_length=3, rng=random.Random(5))
    g.set_food((7, 3))
    text = TerminalRenderer(g).frame()
    lines = text.splitlines()
    check('渲染行数 = 高 + 3', len(lines) == 4 + 3)
    check('每行宽度 = 宽 + 2', all(len(ln) == 8 + 2 for ln in lines[1:1 + 4]))
    check('蛇头标记唯一', text.count(SNAKE_HEAD) == 1)
    check('食物标记唯一', text.count(FOOD) == 1)
    check('渲染不改变逻辑状态', (len(g.body), g.score, g.alive) == (3, 0, True))

    failed = [n for n, ok in checks if not ok]
    for name, ok in checks:
        print(f"  [{'ok  ' if ok else 'FAIL'}] {name}")
    print()
    print('PASS' if not failed else 'FAIL',
          f'({len(checks) - len(failed)}/{len(checks)} passed)')
    return 0 if not failed else 1


# ---------------- 入口 ----------------
def main(argv=None):
    parser = argparse.ArgumentParser(description='终端贪吃蛇（文本渲染）')
    parser.add_argument('--selftest', action='store_true',
                        help='无头自测，打印 PASS/FAIL 后退出')
    parser.add_argument('--width', type=int, default=24)
    parser.add_argument('--height', type=int, default=12)
    parser.add_argument('--fps', type=float, default=8.0,
                        help='每秒步进次数（默认 8）')
    args = parser.parse_args(argv)

    if args.selftest:
        return run_selftest()
    return run_game(args.width, args.height, args.fps)


if __name__ == '__main__':
    sys.exit(main())

运行说明

· 自测：`python3 game.py --selftest` → 逐条打印用例，末行 `PASS`（退出码 0）或 `FAIL`（退出码 1）。用例中 `撞右墙死亡` 是负向对照：注掉 `step()` 里的边界判断即变红。
· 游戏：`python3 game.py`，WASD / hjkl / 方向键移动，q 退出；`--width --height --fps` 可调，如 `python3 game.py --width 30 --height 15 --fps 12`。
· 输入：类 Unix 用 `termios` + `select` 逐键读取，Windows 用 `msvcrt`；非 tty（管道/CI）自动降级为空转，不会卡死。
