单文件终端贪吃蛇：逻辑层 SnakeGame 不引用任何终端模块，渲染层与输入层独立，--selftest 走无头路径。

#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""贪吃蛇 (终端文本渲染) —— 核心逻辑与渲染分离。

分层:
    SnakeGame        纯逻辑层: 不导入终端模块、不打印、可无头运行
    Renderer         渲染接口 (只读游戏状态, 不修改)
      NullRenderer   无头渲染, 用于自测
      TerminalRenderer 终端 ANSI 文本渲染
    KeyReader        跨平台单键读取 (POSIX cbreak / Windows msvcrt)

用法:
    python3 game.py                # 开始游戏
    python3 game.py --selftest     # 无头自测, 打印 PASS 或 FAIL
    python3 game.py --width 30 --height 20 --speed 8 --seed 42
"""

from __future__ import annotations

import argparse
import io
import os
import random
import sys
import time
from collections import deque
from typing import Deque, List, Optional, Sequence, Set, Tuple

Cell = Tuple[int, int]

UP: Cell = (0, -1)
DOWN: Cell = (0, 1)
LEFT: Cell = (-1, 0)
RIGHT: Cell = (1, 0)
DIRECTIONS = (UP, DOWN, LEFT, RIGHT)


def opposite(direction: Cell) -> Cell:
    """返回相反方向。"""
    return (-direction[0], -direction[1])


# --------------------------------------------------------------------------- #
# 逻辑层
# --------------------------------------------------------------------------- #
class SnakeGame:
    """贪吃蛇核心逻辑。无 I/O、无终端依赖，可完全无头驱动。"""

    def __init__(self, width: int = 20, height: int = 15,
                 rng: Optional[random.Random] = None) -> None:
        if width < 3 or height < 3:
            raise ValueError("width 与 height 至少为 3")
        self.width = int(width)
        self.height = int(height)
        self.rng = rng if rng is not None else random.Random()

        self.snake: Deque[Cell] = deque()      # 蛇头在索引 0
        self.occupied: Set[Cell] = set()       # 与 snake 保持同步, 供 O(1) 查询
        self.food: Optional[Cell] = None
        self.direction: Cell = RIGHT
        self.pending: Deque[Cell] = deque()    # 转向输入缓冲
        self.score = 0
        self.steps = 0
        self.game_over = False
        self.win = False
        self.reset()

    # ---------------- 状态重置 ----------------
    def reset(self, snake: Optional[Sequence[Cell]] = None,
              direction: Cell = RIGHT) -> None:
        """重开一局。"""
        if snake is None:
            cx = max(2, self.width // 2)
            cy = self.height // 2
            snake = [(cx, cy), (cx - 1, cy), (cx - 2, cy)]
        self.score = 0
        self.steps = 0
        self.place(snake, direction)

    def place(self, snake: Sequence[Cell], direction: Cell = RIGHT) -> None:
        """直接摆放蛇身并重投食物（自测 / 重开使用）。"""
        self.snake = deque(snake)
        self.occupied = set(snake)
        self.direction = direction
        self.pending.clear()
        self.game_over = False
        self.win = False
        self._spawn_food()

    # ---------------- 查询 ----------------
    @property
    def head(self) -> Cell:
        return self.snake[0]

    # ---------------- 输入 ----------------
    def turn(self, direction: Cell) -> bool:
        """请求转向。反向 / 重复输入被忽略，返回是否入队。"""
        if direction not in DIRECTIONS:
            return False
        ref = self.pending[-1] if self.pending else self.direction
        if direction == ref or direction == opposite(ref):
            return False
        if len(self.pending) >= 2:          # 最多缓存两次转向
            return False
        self.pending.append(direction)
        return True

    # ---------------- 推进 ----------------
    def step(self) -> None:
        """推进一帧。游戏结束后调用无副作用。"""
        if self.game_over:
            return
        if self.pending:
            self.direction = self.pending.popleft()

        hx, hy = self.snake[0]
        dx, dy = self.direction
        new_head = (hx + dx, hy + dy)

        # 撞墙
        if not (0 <= new_head[0] < self.width and 0 <= new_head[1] < self.height):
            self.game_over = True
            return

        tail = self.snake[-1]
        eating = new_head == self.food
        # 撞自己；若新头正是即将离开的尾格则合法
        if new_head in self.occupied and not (new_head == tail and not eating):
            self.game_over = True
            return

        self.snake.appendleft(new_head)
        self.occupied.add(new_head)
        self.steps += 1

        if eating:
            self.score += 1
            self._spawn_food()
        else:
            removed = self.snake.pop()
            if removed != new_head:          # 追尾场景: 同一格不应被移除
                self.occupied.discard(removed)

    # ---------------- 内部 ----------------
    def _spawn_food(self) -> None:
        free = [(x, y)
                for y in range(self.height)
                for x in range(self.width)
                if (x, y) not in self.occupied]
        if not free:
            self.food = None
            self.win = True                  # 蛇占满棋盘 = 通关
            self.game_over = True
            return
        self.food = self.rng.choice(free)


# --------------------------------------------------------------------------- #
# 渲染层
# --------------------------------------------------------------------------- #
class Renderer:
    """渲染接口: 只读 game 状态, 绝不修改。"""

    def render(self, game: SnakeGame, paused: bool = False) -> None:
        raise NotImplementedError


class NullRenderer(Renderer):
    """无头渲染器: 自测 / 服务端驱动时使用。"""

    def __init__(self) -> None:
        self.frames = 0

    def render(self, game: SnakeGame, paused: bool = False) -> None:
        self.frames += 1


class TerminalRenderer(Renderer):
    """ANSI 文本渲染。输出目标可注入（便于断言）。"""

    HEAD = "O"
    BODY = "o"
    FOOD = "*"
    EMPTY = " "

    def __init__(self, out=None, use_color: bool = True) -> None:
        self.out = out if out is not None else sys.stdout
        try:
            is_tty = bool(self.out.isatty())
        except Exception:
            is_tty = False
        self.ansi = is_tty                   # 非 tty 时不输出控制序列
        self.use_color = bool(use_color) and is_tty

    def _paint(self, text: str, code: str) -> str:
        if not self.use_color:
            return text
        return "\x1b[{}m{}\x1b[0m".format(code, text)

    def render(self, game: SnakeGame, paused: bool = False) -> None:
        head = game.head if game.snake else None
        rows: List[str] = []
        rows.append("score: {}   size: {}x{}   steps: {}".format(
            game.score, game.width, game.height, game.steps))
        rows.append("+" + "-" * game.width + "+")

        for y in range(game.height):
            cells: List[str] = []
            for x in range(game.width):
                pos = (x, y)
                if pos == head:
                    cells.append(self._paint(self.HEAD, "1;32"))
                elif pos in game.occupied:
                    cells.append(self._paint(self.BODY, "32"))
                elif pos == game.food:
                    cells.append(self._paint(self.FOOD, "1;31"))
                else:
                    cells.append(self.EMPTY)
            rows.append("|" + "".join(cells) + "|")

        rows.append("+" + "-" * game.width + "+")
        if game.game_over:
            rows.append("GAME OVER" + ("  你赢了!" if game.win else "")
                        + "  最终分数: {}".format(game.score))
        elif paused:
            rows.append("PAUSED —— 按 p 继续, q 退出")
        else:
            rows.append("方向: WASD / 方向键    p 暂停    q 退出")

        prefix = "\x1b[H\x1b[2J" if self.ansi else ""
        self.out.write(prefix + "\n".join(rows) + "\n")
        self.out.flush()


# --------------------------------------------------------------------------- #
# 输入层
# --------------------------------------------------------------------------- #
_KEY_TO_DIR = {"up": UP, "down": DOWN, "left": LEFT, "right": RIGHT}


class KeyReader:
    """跨平台单键读取。POSIX 进 cbreak, Windows 用 msvcrt。"""

    _CHARS = {
        "w": "up", "W": "up", "k": "up",
        "s": "down", "S": "down", "j": "down",
        "a": "left", "A": "left", "h": "left",
        "d": "right", "D": "right", "l": "right",
        "q": "quit", "Q": "quit",
        "p": "pause", "P": "pause",
    }

    def __init__(self) -> None:
        self.is_windows = os.name == "nt"
        self._fd = None
        self._saved = None

    def __enter__(self) -> "KeyReader":
        if not self.is_windows:
            try:
                import termios
                import tty
                self._fd = sys.stdin.fileno()
                self._saved = termios.tcgetattr(self._fd)
                tty.setcbreak(self._fd)
            except Exception:
                self._saved = None           # stdin 非 tty: 退化为无输入
        return self

    def __exit__(self, *exc_info) -> bool:
        if not self.is_windows and self._saved is not None:
            import termios
            termios.tcsetattr(self._fd, termios.TCSADRAIN, self._saved)
        return False

    def poll(self, timeout: float) -> Optional[str]:
        if self.is_windows:
            return self._poll_windows(timeout)
        return self._poll_posix(timeout)

    # ---------------- POSIX ----------------
    def _poll_posix(self, timeout: float) -> Optional[str]:
        if self._saved is None:              # 无 tty, 只做节流
            time.sleep(max(0.0, timeout))
            return None
        import select
        deadline = time.monotonic() + timeout
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                return None
            ready, _, _ = select.select([sys.stdin], [], [], remaining)
            if not ready:
                return None
            ch = sys.stdin.read(1)
            if ch == "":                     # EOF
                return None
            if ch == "\x1b":
                arrow = self._read_escape()
                return arrow if arrow else "quit"
            mapped = self._CHARS.get(ch)
            if mapped:
                return mapped
            # 其它按键忽略, 继续等到超时

    def _read_escape(self) -> Optional[str]:
        import select
        ready, _, _ = select.select([sys.stdin], [], [], 0.03)
        if not ready:
            return None
        if sys.stdin.read(1) != "[":
            return None
        ready, _, _ = select.select([sys.stdin], [], [], 0.03)
        if not ready:
            return None
        code = sys.stdin.read(1)
        return {"A": "up", "B": "down", "C": "right", "D": "left"}.get(code)

    # ---------------- Windows ----------------
    def _poll_windows(self, timeout: float) -> Optional[str]:
        import msvcrt
        deadline = time.monotonic() + timeout
        while True:
            if msvcrt.kbhit():
                ch = msvcrt.getwch()
                if ch in ("\x00", "\xe0"):   # 功能键前缀
                    code = msvcrt.getwch()
                    return {"H": "up", "P": "down",
                            "K": "left", "M": "right"}.get(code)
                mapped = self._CHARS.get(ch)
                if mapped:
                    return mapped
            if time.monotonic() >= deadline:
                return None
            time.sleep(0.005)


# --------------------------------------------------------------------------- #
# 无头自测
# --------------------------------------------------------------------------- #
def run_selftest() -> int:
    """不依赖终端、不进入主循环的断言集合。成功打印 PASS, 否则 FAIL。"""
    checks: List[Tuple[str, bool]] = []

    def check(name: str, cond: bool) -> None:
        checks.append((name, bool(cond)))

    # 1. 初始状态合法
    g = SnakeGame(10, 8, random.Random(1))
    check("初始蛇长 = 3", len(g.snake) == 3)
    check("初始蛇身与 occupied 一致", len(g.occupied) == 3)
    check("食物不在蛇身上", g.food not in g.occupied)
    check("食物在界内", 0 <= g.food[0] < g.width and 0 <= g.food[1] < g.height)

    # 2. 正常前进 (钉死食物位置以排除随机干扰)
    g = SnakeGame(10, 8, random.Random(2))
    g.food = (0, 0)
    g.step()
    check("前进一格且长度不变",
          g.head == (6, 4) and len(g.snake) == 3)

    # 3. 反向输入被拒绝 (负向控制: 注入非法输入, 行为必须不变)
    g = SnakeGame(10, 8, random.Random(3))
    g.food = (0, 0)
    check("反向转向返回 False", g.turn(LEFT) is False)
    g.step()
    check("拒绝反向后仍向右", g.head == (6, 4))

    # 4. 吃食物: 加分 + 变长 + 重投位置合法
    g = SnakeGame(10, 8, random.Random(4))
    hx, hy = g.head
    g.food = (hx + 1, hy)
    n0 = len(g.snake)
    g.step()
    check("吃到食物加分", g.score == 1)
    check("吃到食物变长", len(g.snake) == n0 + 1)
    check("重投食物不与蛇重叠", g.food is not None and g.food not in g.occupied)

    # 5. 撞墙
    g = SnakeGame(6, 5, random.Random(5))
    g.place([(5, 2), (4, 2), (3, 2)], RIGHT)
    g.food = (0, 0)
    g.step()
    check("撞墙 -> game_over", g.game_over and not g.win)

    # 6. 撞自己
    g = SnakeGame(10, 10, random.Random(6))
    g.place([(1, 1), (2, 1), (2, 2), (1, 2)], RIGHT)
    g.food = (9, 9)
    g.step()
    check("撞自己 -> game_over", g.game_over)

    # 6b. 追尾合法 (头进入即将腾出的尾格)
    g = SnakeGame(10, 10, random.Random(7))
    g.place([(2, 1), (2, 2), (1, 2), (1, 1)], LEFT)
    g.food = (9, 9)
    g.step()
    check("追尾不算撞自己", not g.game_over)

    # 7. 食物投放不变量
    g = SnakeGame(12, 10, random.Random(8))
    ok = True
    for _ in range(200):
        g._spawn_food()
        ok = ok and g.food not in g.occupied
    check("食物投放 200 次从不与蛇重叠", ok)

    # 8. 随机走 300 步, 不变量全程成立
    g = SnakeGame(15, 12, random.Random(9))
    ok = True
    for _ in range(300):
        if g.game_over:
            break
        g.turn(random.Random(g.steps).choice(DIRECTIONS))
        g.step()
        ok = ok and len(g.snake) == len(g.occupied)
        ok = ok and len(set(g.snake)) == len(g.snake)
        ok = ok and (g.food is None or g.food not in g.occupied)
        ok = ok and all(0 <= x < g.width and 0 <= y < g.height for x, y in g.snake)
    check("300 步随机走位不变量成立", ok)

    # 9. 满盘 = 胜利
    g = SnakeGame(3, 3, random.Random(10))
    g.place([(0, 0), (1, 0), (2, 0), (0, 1), (1, 1), (2, 1), (0, 2), (1, 2), (2, 2)])
    check("棋盘占满 -> win 且结束", g.food is None and g.win and g.game_over)

    # 10. 逻辑与渲染分离: 渲染器可无头使用, 且不改变状态
    g = SnakeGame(8, 6, random.Random(11))
    null = NullRenderer()
    null.render(g)
    buf = io.StringIO()
    text = TerminalRenderer(out=buf, use_color=False)
    text.render(g)
    out = buf.getvalue()
    check("NullRenderer 计帧", null.frames == 1)
    check("文本渲染含蛇头", TerminalRenderer.HEAD in out)
    check("文本渲染含食物", TerminalRenderer.FOOD in out)
    check("文本渲染含分数行", "score: 0" in out)
    check("渲染不修改游戏状态",
          len(g.snake) == 3 and g.score == 0 and not g.game_over)

    failed = [name for name, ok in checks if not ok]
    for name, ok in checks:
        print("  {} {}".format("OK  " if ok else "FAIL", name))
    print("PASS" if not failed else "FAIL")
    return 0 if not failed else 1


# --------------------------------------------------------------------------- #
# 主循环
# --------------------------------------------------------------------------- #
def parse_args(argv=None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="终端贪吃蛇 (逻辑与渲染分离)")
    parser.add_argument("--selftest", action="store_true",
                        help="无头自测, 打印 PASS 或 FAIL")
    parser.add_argument("--width", type=int, default=20, help="棋盘宽 (>=3)")
    parser.add_argument("--height", type=int, default=15, help="棋盘高 (>=3)")
    parser.add_argument("--speed", type=float, default=10.0, help="每秒步数")
    parser.add_argument("--seed", type=int, default=None, help="随机种子, 可复现")
    parser.add_argument("--no-color", action="store_true", help="禁用颜色")
    return parser.parse_args(argv)


def play(args: argparse.Namespace) -> int:
    if args.speed <= 0:
        print("--speed 必须大于 0", file=sys.stderr)
        return 2
    try:
        game = SnakeGame(args.width, args.height, random.Random(args.seed))
    except ValueError as exc:
        print("参数错误: {}".format(exc), file=sys.stderr)
        return 2

    renderer = TerminalRenderer(use_color=not args.no_color)
    delay = 1.0 / args.speed
    paused = False
    running = True

    try:
        with KeyReader() as keys:
            if renderer.ansi:
                sys.stdout.write("\x1b[?25l")     # 隐藏光标
                sys.stdout.flush()

            while running and not game.game_over:
                renderer.render(game, paused=paused)

                if paused:                        # 暂停: 低频等待按键
                    key = keys.poll(0.1)
                    if key == "quit":
                        running = False
                    elif key == "pause":
                        paused = False
                    continue

                deadline = time.monotonic() + delay
                while True:                       # 帧间收集输入
                    remaining = deadline - time.monotonic()
                    if remaining <= 0:
                        break
                    key = keys.poll(remaining)
                    if key is None:
                        break
                    if key == "quit":
                        running = False
                        break
                    if key == "pause":
                        paused = True
                        break
                    direction = _KEY_TO_DIR.get(key)
                    if direction is not None:
                        game.turn(direction)

                if not running or paused:
                    continue
                game.step()

            renderer.render(game, paused=paused)
    except KeyboardInterrupt:
        print()
        return 130
    finally:
        if renderer.ansi:
            sys.stdout.write("\x1b[?25h")         # 恢复光标
            sys.stdout.flush()

    if game.game_over:
        print("GAME OVER{}  分数: {}".format(
            "  (你赢了!)" if game.win else "", game.score))
    return 0


def main(argv=None) -> int:
    args = parse_args(argv)
    if args.selftest:
        return run_selftest()
    return play(args)


if __name__ == "__main__":
    sys.exit(main())

运行说明

· 自测（无头，不进终端界面）：`python3 game.py --selftest` — 逐条打印 OK/FAIL，末行 `PASS`（退出码 0）或 `FAIL`（退出码 1）。
· 游戏：`python3 game.py`；可选 `--width 30 --height 20 --speed 8 --seed 42`。
· 操作：WASD / hjkl / 方向键转向，`p` 暂停，`q` 或 `ESC` 退出，`Ctrl-C` 中断。
· 注意：交互需 stdin 为 tty；重定向/管道下 `KeyReader` 退化为无输入，游戏会自行跑到结束。

