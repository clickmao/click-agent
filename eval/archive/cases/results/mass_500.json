   "pass": true,
   "notes": [],
   "reply": "/// <summary>对节点 In0/In1 各自 Resolve 后汇总处理。</summary>\nvoid ProcessOperands(Graph g, int id)\n{\n    ref var nn = ref g.N[id];       // 取引用, 避免结构体拷贝\n    var a0 = g.Resolve(nn.In0);     // 直接展开两次调用\n    var a1 = g.Resolve(nn.In1);\n\n    Combine(a0, a1);                // 汇总处理\n}\n\n最直接的写法就是顺序两行调用，不用循环——只有两个操作数，循环纯属多余；尤其避免 foreach (var x in new[] { nn.In0, nn.In1 })，那会为取两个栈上字段每次分配数组（R01）。",
